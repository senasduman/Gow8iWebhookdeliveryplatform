DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook?sslmode=disable
API_KEY_PEPPER=replace-with-a-long-random-secret
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
WEBHOOK_ENCRYPTION_KEY=base64-encoded-32-byte-key
WEBHOOK_LEGACY_SECRET_HEADER=false
HTTP_ADDR=:8080
WORKER_COUNT=4
MAX_ATTEMPTS=8
DELIVERY_TIMEOUT=10s
